---
import { site } from '../config';

const { portalId, formId, region, embedScript, target } = site.hubspot;
const targetId = target.replace(/^#/, '');
---

<div class="hs-embed" data-hs-portal={portalId} data-hs-form={formId} data-hs-region={region}>
  <div id={targetId} class="hs-form-target" aria-live="polite">
    <p class="fine hs-loading" id="hs-loading">Loading the consultation form…</p>
  </div>
  <p class="fine hs-load-error" id="hs-load-error" hidden>
    The form could not load in this browser (a privacy or ad blocker may be stopping it). Email us at
    <a href={`mailto:${site.email}?subject=${encodeURIComponent('Consultation request — Privacy Ridge')}`}>{site.email}</a>
    and we will reply to set a time.
  </p>
  <noscript>
    <p class="fine">
      This form needs JavaScript. Email <a href={`mailto:${site.email}`}>{site.email}</a> or call
      <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a> instead.
    </p>
  </noscript>
  <p class="fine hs-fallback">
    Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>
</div>

<!-- HubSpot's hosted embed script (legacy form, na2). Do not self-host. -->
<script is:inline charset="utf-8" type="text/javascript" src={embedScript}></script>
<script is:inline define:vars={{ portalId, formId, region, target }}>
  (function () {
    var loading = document.getElementById('hs-loading');
    var failed = document.getElementById('hs-load-error');
    var done = false;
    function showError() {
      if (done) return;
      done = true;
      if (loading) loading.hidden = true;
      if (failed) failed.hidden = false;
    }
    // Free/Starter portals render legacy forms inside a same-origin iframe and
    // ignore `css`. Copy the site's stylesheets into that iframe so the form
    // uses the site's own field, checkbox and button styles.
    function styleFrame() {
      var host = document.querySelector(target);
      var frame = host && host.querySelector('iframe');
      var doc = null;
      try {
        doc = frame && frame.contentDocument;
      } catch (e) {
        doc = null;
      }
      if (!doc || !doc.head || doc.getElementById('pr-site-styles')) return;
      var marker = doc.createElement('meta');
      marker.id = 'pr-site-styles';
      doc.head.appendChild(marker);
      document.querySelectorAll('link[rel="stylesheet"], style').forEach(function (node) {
        if (node.tagName === 'LINK') {
          var link = doc.createElement('link');
          link.rel = 'stylesheet';
          link.href = node.href;
          doc.head.appendChild(link);
        } else if (node.textContent && node.textContent.indexOf('hs-embed') !== -1) {
          doc.head.appendChild(node.cloneNode(true));
        }
      });
      if (doc.body) doc.body.classList.add('hs-embed', 'hs-embed-frame');
    }
    function create() {
      if (!window.hbspt || !window.hbspt.forms) return false;
      window.hbspt.forms.create({
        region: region,
        portalId: portalId,
        formId: formId,
        target: target,
        css: '',
        submitButtonClass: 'button hs-button primary',
        onFormReady: function () {
          done = true;
          if (loading) loading.hidden = true;
          styleFrame();
        },
      });
      return true;
    }
    if (!create()) {
      var tries = 0;
      var timer = setInterval(function () {
        tries += 1;
        if (create()) clearInterval(timer);
        else if (tries > 40) {
          clearInterval(timer);
          showError();
        }
      }, 250);
    }
    // If nothing rendered after 12s (blocked script or network), show email.
    setTimeout(function () {
      var host = document.querySelector(target);
      var rendered = host && host.querySelector('form, iframe');
      if (!rendered) showError();
    }, 12000);
  })();
</script>
