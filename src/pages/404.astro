---
import Base from '../layouts/Base.astro';

const title = 'Page not found | Privacy Ridge';
const description = 'That page is not on the Privacy Ridge site.';
---

<Base title={title} description={description} noindex>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not here.</h1>
      <p class="lede">The link may be old, or the address may be mistyped.</p>
      <div class="hero-actions">
        <a class="button" href="/">Back to the homepage</a>
        <a class="quiet-link" href="/contact">Book a consultation</a>
      </div>
    </div>
  </header>
</Base>
